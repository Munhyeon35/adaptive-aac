# Optional. Copy to .env; nothing is sent until cloud suggestions are enabled in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AAC_PORT=8765
AAC_DB_PATH=var/aac.sqlite3
# auto loads the model activated by setup_local.py; off disables local inference.
AAC_LOCAL_MODEL=auto
# Optional manual local adapter directory (with AAC_LOCAL_MODEL=<model directory>).
AAC_LOCAL_ADAPTER=
